{
  "name": "dsh-extra-body",
  "version": "0.1.0",
  "description": "Add per-model JSON fields to DSH model generation requests.",
  "repository": { "type": "git", "url": "git+ssh://git@github.com/hoshinohikari/dsh-extra-body.git" },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.3" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
